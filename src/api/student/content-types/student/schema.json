{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student",
    "description": "Independent student account"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "phone": { "type": "string", "required": true, "unique": true },
    "password": { "type": "password", "private": true, "required": true },
    "birthdate": { "type": "date" },
    "gender": { "type": "enumeration", "enum": ["male", "female"] },
    "age": { "type": "integer" },
    "hasParent": { "type": "boolean", "default": false },
    "role": { "type": "enumeration", "enum": ["child", "student"] },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::parent.parent",
      "inversedBy": "children"
    },
    "registrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::registration.registration",
      "mappedBy": "student"
    }
  }
}
