{
  "kind": "collectionType",
  "collectionName": "children",
  "info": {
    "singularName": "child",
    "pluralName": "children",
    "displayName": "Child",
    "description": "Child profile belonging to a parent"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "gender": {
      "type": "enumeration",
      "enum": ["male", "female"]
    },
    "birthdate": {
      "type": "date"
    },
    "phone": {
      "type": "string"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::parent.parent",
      "inversedBy": "children",
      "required": true
    },
    "registrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::registration.registration",
      "mappedBy": "child"
    }
  }
}
