{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment",
    "description": "Payments linked to registrations and parents"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "amount": {
      "type": "decimal",
      "required": true
    },
    "transaction_id": {
      "type": "string",
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "completed", "failed"],
      "default": "pending",
      "required": true
    },
    "date": {
      "type": "datetime"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::parent.parent",
      "inversedBy": "payments",
      "required": true
    },
    "registration": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::registration.registration",
      "inversedBy": "payment",
      "required": true
    }
  }
}
